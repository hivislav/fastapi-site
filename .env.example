# Скопируйте этот файл в .env и подставьте СВОИ ключи (.env в .gitignore —
# секреты в репозиторий не попадают; здесь только имена переменных).

# --- Провайдер по умолчанию: официальный API DeepSeek (deepseek-official) ---
# Его модель (DeepSeek-V4-Flash) обслуживает обычные запросы, экспертные
# режимы, «Температуру», судью-аналитика и AI-агента.
DEEPSEEK_API_KEY=вставьте_сюда_ваш_ключ
# Необязательно: адрес и модель провайдера (значения по умолчанию показаны).
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#DEEPSEEK_MODEL=deepseek-v4-flash
# Reasoning (thinking) модели по умолчанию выключен ВСЕГДА (поле thinking:
# {"type": "disabled"} уходит в каждом запросе). 0 — не выключать принудительно.
#LLM_DISABLE_THINKING=1
# Курс доллара для перевода тарифа DeepSeek (он в долларах за 1M токенов) в
# рубли: сайт показывает стоимость в рублях. ОЦЕНКА — обновляйте вручную
# (по умолчанию курс ЦБ РФ на 23.09.2026). Пиковые часы DeepSeek (01:00–04:00 и
# 06:00–10:00 UTC, Пн–Пт) считаются по прайсу провайдера, трогать их не нужно.
#USD_RUB=84.0657
LLM_MAX_TOKENS=800

# --- Старый провайдер: Yandex Cloud AI Studio (модели «Теста моделей») ---
# Ключ нужен, чтобы работали старые модели (DeepSeek 4 Flash (Yandex),
# Alice AI LLM, Alice AI LLM Flash): они доступны ТОЛЬКО при ручном выборе в
# настройке «Тест моделей». Адрес и модель можно переопределить.
YANDEX_API_KEY=вставьте_сюда_ваш_ключ
#YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
#YANDEX_MODEL=gpt://b1gkm5u908if6dc0focb/deepseek-v4-flash/latest

# --- ЛОКАЛЬНАЯ модель (MLX): тумблер «локальная / удалённая» в панели workspace ---
# Локальный источник ответа — сервер mlx_lm.server (пакет mlx-lm) на ЭТОМ же Mac
# (Apple Silicon). Источник ОДИН на всё приложение: обычный режим, эксперт,
# судья, AI-агент и RAG берут модель отсюда, а переключается он кнопкой в панели
# workspace или маршрутом POST /api/agent/llm/source.
#
# Установка и запуск (всё окружение — ВНУТРИ проекта, в data/local_llm):
#   tools/local_llm.sh install     окружение mlx-lm + веса (~5 ГБ, нужна сеть)
#   tools/local_llm.sh start|stop|status|logs|ask "вопрос"
# Приложение поднимает сервер САМО, когда переключатель ставят на локальную
# модель: отдельным процессом, поэтому загрузка весов не занимает ни память, ни
# поток веб-приложения. Веса и кэш HuggingFace уводятся в data/local_llm/models
# (HF_HOME), наружу ничего не пишется.
#
# Значения по умолчанию — рекомендованные для Mac mini M4 16 ГБ:
# Qwen3-8B в 4-битном квантовании (4,6 ГБ на диске, ~6,1 ГБ физической памяти с
# загруженной моделью, ~17 ток/с). Веса и адрес сервера можно переопределить.
#LOCAL_LLM_HOME=data/local_llm
#LOCAL_LLM_MODEL=mlx-community/Qwen3-8B-4bit
#LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
#LOCAL_LLM_HOST=127.0.0.1
#LOCAL_LLM_PORT=8080
# Человекочитаемое имя модели для интерфейса (в промпт не идёт).
#LOCAL_LLM_TITLE=Qwen3-8B-4bit (MLX)
# Провайдеру нужен НЕПУСТОЙ ключ (клиент не зовёт модель без ключа): локальный
# сервер авторизацию не проверяет, значение условное.
#LOCAL_LLM_API_KEY=local
# Источник ДО первого переключения: remote (как было всегда) или local.
#LLM_SOURCE=remote
# Отсрочка автоостановки локального сервера, секунды (0 — гасить сразу).
# Переключились на удалённую модель — локальный сервер живёт ещё столько и
# гаснет сам, освобождая память; вернулись на локальную раньше — отсрочка
# отменяется и веса НЕ читаются заново (это нужно для сравнения ответов).
#LOCAL_LLM_STOP_GRACE=120
# Файл выбранного источника: его пишет переключатель, выбор переживает
# перезапуск приложения. По умолчанию — data/local_llm/source.json.
#LLM_SOURCE_FILE=data/local_llm/source.json

# --- Необязательные настройки устойчивости и расхода (значения по умолчанию) ---
# Сколько ДОПОЛНИТЕЛЬНЫХ попыток делает клиент при 429/5xx и сетевом сбое.
# Повторы не делаются при 400/401/403 — это не сбой сети.
#LLM_RETRIES=2
# Повторять ли вызов, оборвавшийся по таймауту (0 — нет): провайдер мог уже
# начать генерировать ответ, поэтому такой повтор дороже.
#LLM_RETRY_TIMEOUT=0
# Читать ответ модели потоком (SSE). Снимает общий таймаут на весь ответ, но
# требует, чтобы провайдер отдавал usage в потоке: без него расход токенов
# неизвестен, а его показывает панель статистики.
#LLM_STREAM=0
# Предел длины ответа шага агента, если пользователь не задал «Длину»
# (0 — без предела: действует ограничение провайдера).
#LLM_AGENT_MAX_TOKENS=0

# --- Пути к данным (по умолчанию — каталог data/ в корне проекта) ---
#AGENT_WORKSPACE_FILE=data/agent_workspace.json
#AGENT_MEMORY_FILE=data/agent_memory.json
#AGENT_PROFILES_FILE=data/profiles.json

# --- MCP: внешние инструменты агента (кнопка «MCP» у шестерёнки проекта) ---
# Локальные серверы проекта (погода, курсы валют, криптовалюты) — процессы на
# официальном MCP SDK (каталог mcp_servers/, см. mcp_servers/README.md). Ключи им
# не нужны. Если Node.js лежит не в PATH, укажите путь здесь; каталог серверов
# можно перенести целиком.
#MCP_NODE_BIN=node
#MCP_SERVERS_DIR=mcp_servers

# --- MCP: свой сервер open-meteo-mcp на VPS (четвёртый сервер проекта) ---
# Погода, прогноз, качество воздуха и координаты. Сервер развёрнут на VPS и
# слушает ТОЛЬКО loopback сервера, поэтому агент ходит к нему через SSH-туннель
# (127.0.0.1:3000 -> VPS) по Streamable HTTP. В репозитории секрета нет: токен
# доступа читается из переменной окружения, а не из кода.
#
# Токен берётся из локального .env.vps каталога сервера (переменная
# MCP_AUTH_TOKEN) — в .env он попадает как значение OPEN_METEO_MCP_TOKEN.
#OPEN_METEO_MCP_URL=http://127.0.0.1:3000/mcp
#OPEN_METEO_MCP_TOKEN=

# --- MCP: свой сервер city-registry-mcp на VPS (пятый сервер проекта) ---
# Реестр городов и жителей: save_city(city, resident) записывает, что человек
# живёт в городе, list_cities() показывает все записи. Тот же приём, что у
# open-meteo: сервер слушает только loopback VPS, агент ходит через свой
# SSH-туннель (127.0.0.1:3001 -> VPS), а в реестре хранится ИМЯ переменной.
#
# Токен берётся из .env.vps каталога сервера (тоже переменная MCP_AUTH_TOKEN) —
# в .env он попадает как значение CITY_REGISTRY_MCP_TOKEN. Токен СВОЙ, отдельный
# от open-meteo: они не взаимозаменяемы.
#CITY_REGISTRY_MCP_URL=http://127.0.0.1:3001/mcp
#CITY_REGISTRY_MCP_TOKEN=

# --- MCP: файлы, которые возвращают инструменты (вложения в чате) ---
# Инструмент может вернуть готовый файл (например .xlsx). Файл сохраняется на
# диск, а в чат уходит карточка со ссылкой на скачивание
# (GET /api/agent/files/<id>). Каталог по умолчанию — data/mcp_files рядом с
# рабочим файлом агента; ссылки на файлы остаются в журнале чата, поэтому
# удалённый по сроку файл отвечает «Файл не найден».
#MCP_ATTACH_DIR=
# Сколько дней хранить вложения (0 — не удалять по возрасту).
#MCP_ATTACH_TTL_DAYS=30
# Пределы каталога вложений: файлов и байтов суммарно (сначала удаляются самые
# старые, свежие не трогаются).
#MCP_ATTACH_MAX_FILES=500
#MCP_ATTACH_MAX_BYTES=209715200

# --- Периодические задачи (кнопка «Новая периодическая задача») ---
# Задача с расписанием: сервер САМ повторяет её запрос через период (по умолчанию
# сутки; период можно назвать и в тексте — «сводка погоды, раз в час») и кладёт
# ответ в чат этой задачи, беря свежие данные внешних инструментов MCP. Повторы
# выполняет планировщик в том же процессе, что и приложение (app/periodic_runner.py).
# Выключить повторы совсем: расписания задач при этом сохраняются.
#PERIODIC_ENABLED=1
# Как часто планировщик заглядывает в расписания, секунды (это НЕ период задачи).
#PERIODIC_TICK_SECONDS=20
# Задержка первого тика после запуска приложения, секунды.
#PERIODIC_START_DELAY=10
# Предел запросов автомата на один повтор: первый строит план и выполняет первый
# шаг, дальше каждый шаг и проверка — отдельный запрос (страховка от зацикливания).
#PERIODIC_MAX_TURNS=24

# --- RAG: распознавание сканов (OCR) ---
# Скан — это PDF из картинок: текстового слоя в нём нет, и без распознавания
# индексировать нечего. Распознавание идёт встроенным в macOS Vision (офлайн,
# русский + английский, без brew и без Python-пакетов): исходник хелпера лежит в
# tools/vision_ocr.swift и собирается один раз через swiftc в data/ocr/bin.
# Режим: auto — распознавать, когда текстового слоя нет (обычный PDF не трогаем);
#        off  — не распознавать (файл без слоя отклоняется с объяснением);
#        always — распознавать всегда и брать результат, если он полнее слоя
#                 (для сканов с испорченным или частичным текстовым слоем).
#RAG_OCR=auto
# Языки распознавания через запятую.
#RAG_OCR_LANGS=ru-RU,en-US
# Уже собранный хелпер (если задан — сборки не будет).
#RAG_OCR_HELPER=

# --- RAG: базы знаний проекта (кнопка «RAG» рядом с «MCP») ---
# Загруженные документы разбираются на текст, режутся на чанки, каждый чанк
# получает вектор (эмбеддинг) и метаданные (источник, заголовок, раздел,
# chunk_id), и всё это ложится ЛОКАЛЬНЫМ индексом в каталог ниже: SQLite —
# рабочее хранилище, JSON — выгрузка для просмотра и переноса. Перед каждым
# запросом агент ищет во ВКЛЮЧЁННЫХ у проекта базах фрагменты по вопросу и
# отвечает по ним (под ответом видны источники); поиск идёт локально и
# обращений к LLM не делает. Поиск по базе считает близость матрицей через
# numpy, если он установлен (приходит вместе с sentence-transformers), иначе
# перебором на Python — результат один и тот же, разница только в скорости
# (на 5 000 чанков: 4 мс против 1,2 с).
# Каталог баз знаний (внутри лежат kb-*/ и кэш моделей).
#RAG_DIR=data/rag
# Предел размера ОДНОГО документа, МБ. Столько принимает потоковая загрузка:
# файл льётся на диск кусками и в памяти целиком не лежит, поэтому ограничение —
# только здравый смысл и место на диске. PDF читается постранично, а накопление
# текста останавливается на пределе индексации (8 млн символов) с предупреждением.
#RAG_MAX_FILE_BYTES=256
# Индексация идёт В ФОНЕ: загрузка отвечает сразу задачей, а прогресс виден в
# диалоге (этап, проценты, «страница 15 из 220»). Отдельных настроек у неё нет —
# одновременно выполняется до 4 задач, завершённые помним 15 минут.
# Предел для НЕбольших файлов, которые уходят в base64 одним JSON-запросом, МБ.
# Здесь потолок задаёт память: base64 раздувает файл на треть и держится в памяти
# трижды (тело, строка, байты). Файл крупнее этого предела интерфейс отправляет
# потоком автоматически — трогать эту настройку обычно не нужно.
#RAG_MAX_JSON_FILE_BYTES=25
# Бэкенд эмбеддингов: auto | sentence-transformers | hashing.
#   auto  — модель, если пакет установлен и модель есть в кэше; иначе встроенный
#           офлайн-бэкенд (лексическая близость, работает без сети и без модели);
#   sentence-transformers — семантические эмбеддинги (нужен пакет + модель);
#   hashing — всегда офлайн, без зависимостей.
#RAG_EMBED_BACKEND=auto
# Модель sentence-transformers (мультиязычная: русский документ и русский вопрос
# попадают в одно векторное пространство).
#RAG_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Размерность встроенного офлайн-бэкенда (64…4096).
#RAG_EMBED_DIM=512
# Каталог кэша моделей: скачивается один раз, дальше работа идёт без сети.
#RAG_MODEL_CACHE=data/rag/models

# --- RAG: поиск по базам знаний для ответов агента (app/ai/rag_search.py) ---
# ЗНАЧЕНИЯ НИЖЕ — только значения ПО УМОЛЧАНИЮ для проекта: в диалоге «База
# знаний» есть панель «Поиск и ответы», и выбранное там хранится в проекте
# (task["rag"]). Окружение отвечает на вопрос «чем поиск работает, если проект
# ещё не настраивали» и позволяет вернуть прежнее поведение без интерфейса.
#
# ПОИСК ИДЁТ В ДВА ЭТАПА. Первый — широкий пул кандидатов из каждой базы
# (RAG_TOP_K_BEFORE), второй — реранкинг этого пула и отсечение по порогу, после
# чего в модель уходит RAG_TOP_K фрагментов с базы. Выключенный этап честно
# выключен: без реранкинга пул равен выборке, без фильтрации не отсекается
# ничего (галочки в панели проекта).
#RAG_RERANK=1
#RAG_FILTER=1
# Сколько кандидатов берёт ПЕРВЫЙ этап из одной базы (пул для реранкинга).
# Реранкинг может переставить только то, что уже нашлось: если нужный чанк не
# попал в пул, второй этап его не вернёт.
#RAG_TOP_K_BEFORE=30
# ЧЕМ РЕРАНКИТЬ (app/ai/rag_rerank.py). auto — cross-encoder, ЕСЛИ его модель уже
# лежит в кэше проекта, иначе признаки (сети auto не касается: поиск не должен
# внезапно качать сотни мегабайт). features — только признаки. cross-encoder —
# модель, и если её нет в кэше, она СКАЧИВАЕТСЯ один раз; сбой загрузки или счёта
# не ломает запрос: поиск честно откатывается на признаки, а причина видна в
# дебаге чата. В панели «Поиск и ответы» это отдельный селект «Чем реранкить».
#RAG_RERANK_BACKEND=auto
# Модель-реранкер (мультиязычная, ~120 МБ, кэш — RAG_MODEL_CACHE внутри проекта).
# Крупнее модель (bge-reranker-base, jina-reranker-v2) точнее, но в разы медленнее.
#RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Сколько пар (запрос, фрагмент) разрешено оценить моделью за ОДИН поиск: пул на
# базу ограничен 50 фрагментами, а баз бывает несколько — без предела один запрос
# занял бы моделью десятки секунд.
#RAG_RERANK_MAX_PAIRS=64
# Предел ожидания счёта модели: поиск идёт в потоке обслуживания запроса, и
# зависший счёт означал бы зависший ответ агента. Не уложились — работают
# признаки, а причина видна в дебаге. Счёт идёт в ОДНОМ рабочем потоке:
# конкурентные вызовы torch — известный источник зависаний.
#RAG_RERANK_TIMEOUT=20
# Предел длины пары в токенах для cross-encoder.
#RAG_RERANK_MAX_LENGTH=512
# Вес вероятности cross-encoder в оценке (в тех же единицах, что лексика).
#RAG_RERANK_CE_WEIGHT=1
# Веса ПРИЗНАКОВОГО реранкинга: фраза (порядок слов в тексте) и адрес (слова
# запроса в заголовке чанка, разделе, имени файла), плюс штраф короткому чанку БЕЗ
# слов запроса (лечение hubness: короткий чанк-заголовок похож на любой запрос).
# Добавка считается от СЕРЕДИНЫ пула: признак, одинаковый у всех кандидатов,
# фрагменты не различает и порядок не меняет (измерено: без этого правила
# попаданий было 7 из 9 вместо 8).
#RAG_RERANK_PHRASE_WEIGHT=0.6
#RAG_RERANK_ADDRESS_WEIGHT=0.25
#RAG_RERANK_SHORT_PENALTY=0.35
# ПЕРЕФОРМУЛИРОВКА ЗАПРОСА (Query Rewrite). Включена — вопрос перед поиском
# превращается в строку ключевых слов: служебным вызовом модели (она умеет
# добавить синонимы), а если вызов не удался или ключа нет — тем же модулем
# локально (app/ai/rag_query.py). Выключена — ни одного обращения к модели и ни
# одного токена: поиск идёт по тексту запроса как есть.
#RAG_REWRITE=1
# СПРАШИВАТЬ ЛИ ПОЛЬЗОВАТЕЛЯ, ЕСЛИ В ДОКУМЕНТАХ НИЧЕГО НЕТ (по умолчанию да).
# Базы включены, поиск прошёл, фрагментов нет — агент НЕ отвечает сам по общим
# знаниям, а останавливается и предлагает варианты (ответить по общим знаниям с
# пометкой, поискать во внешних инструментах, уточнить вопрос). Решение — за
# человеком; выключено — агент отвечает сам, но с пометкой «не из ваших документов».
#RAG_ASK_WHEN_EMPTY=1
# Сколько фрагментов уходит в модель из ОДНОЙ базы ПОСЛЕ второго этапа. Фрагменты
# короткие (350 символов — по окну модели эмбеддингов), поэтому их можно отправлять
# больше: тот же бюджет контекста вмещает больше осмысленных кусков, а случайный
# шум отсекает порог уверенности модели (панель «Поиск и ответы»).
#RAG_TOP_K=8
# Сколько фрагментов уходит в модель ВСЕГО (по всем включённым базам вместе).
# Это и есть бюджет контекста под документы: 16 коротких фрагментов — примерно
# 5–6 тысяч токенов на запрос вместе с адресами и правилами.
#RAG_MAX_HITS=16
# В ПАНЕЛИ ПРОЕКТА ПОРОГ ОДИН — уверенность модели (RAG_MIN_CE ниже). Порога по
# «оценке поиска» (сумма косинусной близости, доли слов запроса и уверенности
# модели) в настройках больше НЕТ: у этой суммы шкала доходит до 3, человеку она
# ничего не говорит («почему релевантность 2,49?»), а фильтровать по ней
# бессмысленно. Явный порог остался только у прямых вызовов поиска (проверки).
#RAG_MIN_SCORE=0.3  # ← читается как значение по умолчанию для явного порога
# ПОРОГ УВЕРЕННОСТИ МОДЕЛИ (0…1) — вероятность cross-encoder; 0 — не применять.
# Отдельная шкала нужна потому, что оценка поиска — СУММА (косинус + слова запроса
# + уверенность модели) и у хорошего фрагмента доходит до 2,49: порог по сумме
# человеку непонятен. У мусора вероятность 0,00–0,02, у нужного 0,45–1,00.
# Применяется только когда пул считала модель (признаковый реранкинг вероятности
# не даёт).
#RAG_MIN_CE=0
# БАЗОВЫЙ ОТСЕВ ШУМА: фрагмент с оценкой ниже этого значения не уходит в модель
# НИКОГДА — ни при каких галочках. Это тот самый порог, который в прежней
# реализации был RAG_MIN_SCORE (0,1): снятая галочка «Фильтрация по порогу»
# отключает порог ПРОЕКТА, но не отменяет отсев шума — иначе «все галочки сняты»
# означало бы «в модель идут фрагменты с оценкой около нуля».
#RAG_MIN_SCORE_FLOOR=0.1
# Вес лексической части в оценке фрагмента (0 — чистый векторный поиск).
# Зачем она вообще: короткие чанки-заголовки лежат близко к центру облака
# векторов и потому «похожи на любой запрос» — в живом случае заголовок из 141
# символа обгонял нужный чанк 0,84 против 0,33. Это известная болезнь плотных
# моделей (hubness). Доля слов запроса (взвешенная по редкости слова в самой
# базе) ставит наверх фрагмент, где эти слова ЕСТЬ. Ноль возвращает прежний
# поиск — на больших базах лексическая часть заметно дороже векторной.
#RAG_LEXICAL_WEIGHT=1
# Предел системного блока с фрагментами, символов.
#RAG_CONTEXT_CHARS=16000
# Предел текста ОДНОГО фрагмента в блоке, символов: фрагмент — законченная мысль,
# а не страница; у старых баз чанк бывает и 8 000 символов.
#RAG_CHUNK_CHARS=1200
# Сколько СОСЕДНИХ фрагментов подмешивать к найденным (0 — не подмешивать).
# Разбиение режет таблицы, списки и пошаговые правила по границе чанка, и
# продолжение ответа остаётся в следующем фрагменте. Живой случай: вопрос про
# зарплаты по «Таблице профессии» — в найденном чанке были городской полицейский
# (1 200) и ассистент корпората (1 500), а строка «Репортёр на зарплате 1 200 /
# месяц» лежала в продолжении таблицы, которое в топ не попало; модель честно
# ответила «в документах этого нет», и ответ был неполным не по её вине. Соседи
# берутся у ДВУХ лучших попаданий и только внутри того же документа; в блоке они
# помечены «продолжение фрагмента № N» и оценки не имеют — это не находки.
#RAG_NEIGHBOURS=1
